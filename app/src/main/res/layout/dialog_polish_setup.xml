<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/cream"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="✨ Chuốt Văn Phong Flash 3.8"
        android:textColor="@color/coral"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/polishBookTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Tên truyện: ..."
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/polishAvailableChapters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Có sẵn: 0 chương"
        android:textColor="@color/sage"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/border_light" />

    <!-- Feature Description -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🤖 Mô hình: Gemini Flash 3.8 (ag/gemini-3.8-flash)"
            android:textColor="@color/coral"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="✓ Gọt giũa câu từ mượt mà, lưu loát, chuẩn văn phong xuất bản.\n✓ Khắc phục triệt để câu cú lủng củng và sạn convert.\n✓ Chuẩn hóa và thống nhất xưng hô nhân vật theo đúng vai vế.\n✓ Tốc độ ~1.5s/chương, tiết kiệm token tối đa."
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Phạm vi chương cần chuốt"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/polishChapterStart"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:gravity="center"
            android:hint="Từ (1)"
            android:inputType="number"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/ink"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="đến"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/polishChapterEnd"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:gravity="center"
            android:hint="Đến hết"
            android:inputType="number"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/ink"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Số luồng xử lý đồng thời"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/polishConcurrency"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:hint="8 luồng (1 - 15)"
        android:inputType="number"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="8"
        android:textColor="@color/ink"
        android:textSize="13sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelPolish"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/border_light"
            android:text="Hủy"
            android:textAllCaps="false"
            android:textColor="@color/ink" />

        <Button
            android:id="@+id/btnStartPolish"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1.6"
            android:backgroundTint="@color/coral"
            android:text="🚀 Bắt đầu chuốt"
            android:textAllCaps="false"
            android:textColor="@color/paper"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
