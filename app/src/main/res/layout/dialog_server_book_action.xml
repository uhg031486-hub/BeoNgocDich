<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Row: Cover + Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="74dp"
                android:layout_height="106dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/cream">

                <ImageView
                    android:id="@+id/dialogBookCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Bìa sách"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_book_placeholder" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dialogBookTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="Tên truyện"
                    android:textColor="@color/ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dialogBookAuthor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Tác giả: Đang cập nhật"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/dialogBookOrigin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_auto"
                        android:text="🤖 Tự động"
                        android:textColor="@color/badge_auto_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dialogBookGenre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_badge_genre"
                        android:text="Huyền Huyễn"
                        android:textColor="@color/badge_genre_text"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/dialogBookStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_badge_complete"
                        android:text="✓ Xong"
                        android:textColor="@color/badge_complete_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/dialogBookModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Mô hình: Đang cập nhật"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Progress Section -->
        <ProgressBar
            android:id="@+id/dialogBookProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="16dp"
            android:max="100"
            android:progress="100"
            android:progressTint="@color/sage" />

        <TextView
            android:id="@+id/dialogBookProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="565 / 565 chương (100%)"
            android:textColor="@color/sage"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/border_light" />

        <!-- ACTION 1: Chuốt lại văn phong FL3.8 & Xuất EPUB (Nổi bật nhất) -->
        <LinearLayout
            android:id="@+id/btnActionPolish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="✨ Chuốt văn phong FL3.8 &amp; Xuất EPUB"
                    android:textColor="@color/coral"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_complete"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:text="Khuyên dùng ⚡"
                    android:textColor="@color/badge_complete_text"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Dùng Gemini Flash 3.8 gọt giũa câu từ mượt mà, lưu loát, thuần Việt, xóa sạch sạn convert và chuẩn hóa xưng hô nhân vật."
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ACTION 2: Xuất / Tải EPUB gốc -->
        <LinearLayout
            android:id="@+id/btnActionExportRaw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/txtExportRawTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📥 Tải bản EPUB gốc"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtExportRawDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tải trực tiếp bản EPUB hiện có trên server (không qua bước chuốt lại văn phong)."
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ACTION 3: Theo dõi tiến độ (nếu đang dịch) -->
        <Button
            android:id="@+id/btnActionTrack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/sage"
            android:text="⏳ Theo dõi tiến độ dịch trên server"
            android:textAllCaps="false"
            android:textColor="@color/paper"
            android:visibility="gone" />

        <!-- ACTION 4: Đóng -->
        <Button
            android:id="@+id/btnActionClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/border_light"
            android:text="Đóng"
            android:textAllCaps="false"
            android:textColor="@color/ink" />
    </LinearLayout>
</ScrollView>
