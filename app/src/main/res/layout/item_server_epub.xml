<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Book Cover Thumbnail -->
    <androidx.cardview.widget.CardView xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="58dp"
        android:layout_height="84dp"
        android:layout_marginEnd="14dp"
        app:cardCornerRadius="6dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/cream">

        <ImageView
            android:id="@+id/bookCoverImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Bìa sách"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_book_placeholder" />
    </androidx.cardview.widget.CardView>

    <!-- Book Details Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Title and Status Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bookTitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Tên truyện"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bookStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_complete"
                android:text="✓ Xong"
                android:textColor="@color/badge_complete_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Origin & Genre Tags Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bookOriginBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_auto"
                android:text="🤖 Tự động dịch"
                android:textColor="@color/badge_auto_text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bookGenreBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_genre"
                android:text="Huyền Huyễn"
                android:textColor="@color/badge_genre_text"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Author and Model -->
        <TextView
            android:id="@+id/bookAuthorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tác giả: Đang cập nhật"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/bookProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progress="100"
            android:progressTint="@color/sage" />

        <!-- Chapter Progress & Hint -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bookProgressText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="565 / 565 chương (100%)"
                android:textColor="@color/sage"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bookActionHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chạm để xem chi tiết"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Quick Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuickExport"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:backgroundTint="@color/border_light"
                android:focusable="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="📥 Tải gốc"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnQuickPolish"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1.4"
                android:backgroundTint="@color/coral"
                android:focusable="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="✨ Chuốt FL3.8"
                android:textAllCaps="false"
                android:textColor="@color/paper"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
