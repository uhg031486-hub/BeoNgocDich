<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:orientation="vertical">

    <!-- Dialog Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📚 Kho Truyện Server &amp; Drive"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cacheStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_complete"
                android:text="⚡ Bộ nhớ đệm"
                android:textColor="@color/badge_complete_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/dialogSubtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Mở nhanh từ bộ nhớ máy • Chạm vào truyện để tải về đọc VBook."
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_light" />

    <!-- Search Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <EditText
            android:id="@+id/searchEditText"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/bg_input"
            android:hint="🔍 Tìm theo tên truyện, tác giả, thể loại..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Filter Row 1: Source (Nguồn: Tất cả / Tự động / Tải lên) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="Nguồn:"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipSourceAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_selected"
                android:text="Tất cả"
                android:textColor="@color/paper"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chipSourceAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="🤖 Tự động dịch (Timo)"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chipSourceUpload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_unselected"
                android:text="📤 Truyện tải lên"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Filter Row 2: Status & Genre (Trạng thái & Thể loại TimoTXT) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="Lọc:"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipStatusAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_selected"
                android:text="Tất cả"
                android:textColor="@color/paper"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chipStatusDone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="✓ Đã xong"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chipStatusTranslating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_chip_unselected"
                android:text="⏳ Đang dịch"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <Spinner
                android:id="@+id/genreFilterSpinner"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_input"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Stats & Sync Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cream"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/dialogStatsText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Đang tải..."
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/dialogRefreshButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="🔄 Đồng bộ mới"
            android:textColor="@color/sage"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_light" />

    <!-- List of Books -->
    <ListView
        android:id="@+id/serverBooksListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/border_light"
        android:dividerHeight="1dp"
        android:scrollbars="vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_light" />

    <!-- Dialog Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper"
        android:gravity="end"
        android:orientation="horizontal"
        android:padding="10dp">

        <Button
            android:id="@+id/dialogCloseButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/sage"
            android:text="Đóng"
            android:textColor="@color/paper" />
    </LinearLayout>
</LinearLayout>
